{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OverlyBroadPassRoleAndCompute",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "ec2:RunInstances",
        "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UnsecuredPublicS3Read",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::example-public-bucket/*"
    }
  ]
}
